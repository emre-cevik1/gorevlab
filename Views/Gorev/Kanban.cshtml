@model IEnumerable<GorevTakipSistemi.Models.Gorev>

@{
    ViewData["Title"] = "Kanban Panosu";
    var bekleyenler = Model.Where(g => g.KanbanDurumu == "Bekleyen").ToList();
    var yapilanlar = Model.Where(g => g.KanbanDurumu == "Yapiliyor").ToList();
    var tamamlananlar = Model.Where(g => g.KanbanDurumu == "Tamamlandi").ToList();
}

<div class="max-w-7xl mx-auto mt-6 px-4">
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-tight">
                Kanban Panosu @(ViewBag.EkipAdi != null ? $"- {ViewBag.EkipAdi}" : "")
            </h1>
            <p class="text-slate-600 text-sm mt-1">Görevleri panoda sürükleyip bırakarak durumlarını hızlıca güncelleyin.</p>
        </div>
        <div class="flex items-center gap-3">
            @if(ViewBag.EkipId != null)
            {
                <a href="/Ekip/Detay/@ViewBag.EkipId" class="bg-white/60 hover:bg-white shadow-sm hover:shadow-md rounded-full px-5 py-2.5 transition-all text-slate-800 font-bold text-sm no-underline inline-flex items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Ekibe Dön
                </a>
            }
        </div>
    </div>

    <!-- KANBAN BOARD -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        
        <!-- SÜTUN: BEKLEYEN -->
        <div class="bg-slate-100/50 rounded-2xl p-4 border border-slate-200/60 min-h-[500px] flex flex-col">
            <div class="flex items-center justify-between mb-4 px-2">
                <h3 class="font-bold text-slate-700 text-sm flex items-center gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-slate-400"></div> Bekleyenler
                </h3>
                <span class="bg-white text-slate-600 text-xs font-bold px-2 py-1 rounded-md shadow-sm border border-slate-100" id="count-bekleyen">@bekleyenler.Count</span>
            </div>
            <div id="col-Bekleyen" class="kanban-col flex-grow flex flex-col gap-3" data-durum="Bekleyen">
                @foreach (var gorev in bekleyenler)
                {
                    <partial name="_KanbanCard" model="gorev" />
                }
            </div>
        </div>

        <!-- SÜTUN: YAPILIYOR -->
        <div class="bg-indigo-50/50 rounded-2xl p-4 border border-indigo-100 min-h-[500px] flex flex-col">
            <div class="flex items-center justify-between mb-4 px-2">
                <h3 class="font-bold text-indigo-800 text-sm flex items-center gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-indigo-500 animate-pulse"></div> Yapılıyor
                </h3>
                <span class="bg-white text-indigo-600 text-xs font-bold px-2 py-1 rounded-md shadow-sm border border-indigo-100" id="count-yapiliyor">@yapilanlar.Count</span>
            </div>
            <div id="col-Yapiliyor" class="kanban-col flex-grow flex flex-col gap-3" data-durum="Yapiliyor">
                @foreach (var gorev in yapilanlar)
                {
                    <partial name="_KanbanCard" model="gorev" />
                }
            </div>
        </div>

        <!-- SÜTUN: TAMAMLANDI -->
        <div class="bg-emerald-50/50 rounded-2xl p-4 border border-emerald-100 min-h-[500px] flex flex-col">
            <div class="flex items-center justify-between mb-4 px-2">
                <h3 class="font-bold text-emerald-800 text-sm flex items-center gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div> Tamamlandı
                </h3>
                <span class="bg-white text-emerald-600 text-xs font-bold px-2 py-1 rounded-md shadow-sm border border-emerald-100" id="count-tamamlandi">@tamamlananlar.Count</span>
            </div>
            <div id="col-Tamamlandi" class="kanban-col flex-grow flex flex-col gap-3" data-durum="Tamamlandi">
                @foreach (var gorev in tamamlananlar)
                {
                    <partial name="_KanbanCard" model="gorev" />
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- SortableJS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        $(document).ready(function() {
            var columns = document.querySelectorAll('.kanban-col');
            
            columns.forEach(function(col) {
                new Sortable(col, {
                    group: 'kanban', // set both lists to same group
                    animation: 150,
                    ghostClass: 'opacity-50',
                    onEnd: function (evt) {
                        var itemEl = evt.item;  // sürüklene öğe
                        var toList = evt.to;    // bırakılan liste
                        
                        var gorevId = itemEl.getAttribute('data-id');
                        var yeniDurum = toList.getAttribute('data-durum');
                        var eskiDurum = evt.from.getAttribute('data-durum');

                        if (yeniDurum !== eskiDurum) {
                            // AJAX ile veritabanını güncelle
                            $.post('/Gorev/KanbanDurumGuncelle', { gorevId: gorevId, yeniDurum: yeniDurum }, function(res) {
                                if(res.success) {
                                    // Sayıları güncelle
                                    updateCounts();
                                    
                                    // Toast mesaj
                                    const Toast = Swal.mixin({
                                        toast: true,
                                        position: 'top-end',
                                        showConfirmButton: false,
                                        timer: 3000,
                                        timerProgressBar: true
                                    });
                                    Toast.fire({
                                        icon: 'success',
                                        title: 'Görev durumu güncellendi'
                                    });
                                } else {
                                    Swal.fire('Hata!', res.message || 'Yetkiniz yok veya bir hata oluştu.', 'error');
                                    // Geri al
                                    evt.from.insertBefore(itemEl, evt.from.children[evt.oldIndex]);
                                }
                            });
                        }
                    },
                });
            });

            function updateCounts() {
                $('#count-bekleyen').text($('#col-Bekleyen').children().length);
                $('#count-yapiliyor').text($('#col-Yapiliyor').children().length);
                $('#count-tamamlandi').text($('#col-Tamamlandi').children().length);
            }
        });
    </script>
}
