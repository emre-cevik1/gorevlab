@{
    ViewData["Title"] = "Görev Takvimi";
}

<div class="max-w-7xl mx-auto mt-6 px-4 mb-12">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-black text-slate-800 flex items-center gap-3">
                <i class="bi bi-calendar-event text-indigo-600"></i> Görev Takvimi
            </h2>
            <p class="text-slate-500 font-medium mt-1">
                Tüm görevlerinizi takvim üzerinden inceleyebilir ve sürükle-bırak ile tarihlerini güncelleyebilirsiniz.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <span class="flex items-center gap-1.5 text-xs font-bold text-slate-500 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-100">
                <span class="w-3 h-3 rounded-full bg-[#10b981]"></span> Tamamlanmış
            </span>
            <span class="flex items-center gap-1.5 text-xs font-bold text-slate-500 bg-indigo-50 px-3 py-1.5 rounded-full border border-indigo-100">
                <span class="w-3 h-3 rounded-full bg-[#4f46e5]"></span> Bekleyen
            </span>
            <span class="flex items-center gap-1.5 text-xs font-bold text-slate-500 bg-red-50 px-3 py-1.5 rounded-full border border-red-100">
                <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span> Yüksek Öncelikli
            </span>
        </div>
    </div>

    <div class="antigravity-card p-6 bg-white rounded-3xl shadow-sm border border-slate-200">
        <div id='calendar' class="min-h-[600px]"></div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar Kütüphanesi -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales/tr.js'></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                themeSystem: 'standard',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Bugün',
                    month: 'Ay',
                    week: 'Hafta',
                    day: 'Gün'
                },
                events: '/Gorev/GetirGorevlerJSON',
                editable: true,       // Sürükle-bırak izni
                droppable: true,
                eventDurationEditable: false, // Şimdilik sadece tarih değiştirsin, süre uzatmasın
                
                // Görev sürüklenip bırakıldığında tetiklenir
                eventDrop: function(info) {
                    // Yalnızca tarihi alıyoruz (örn: 2026-05-29)
                    var yeniTarihStr = info.event.startStr; 
                    
                    $.ajax({
                        url: '/Gorev/GuncelleGorevTarih',
                        type: 'POST',
                        data: {
                            id: info.event.id,
                            yeniTarih: yeniTarihStr
                        },
                        success: function(response) {
                            if(response.success) {
                                toastr.success(response.message, "Başarılı");
                            } else {
                                toastr.error(response.message, "Hata");
                                info.revert(); // Hata durumunda takvimi eski haline döndür
                            }
                        },
                        error: function() {
                            toastr.error("Sunucu ile iletişim kurulamadı.", "Bağlantı Hatası");
                            info.revert();
                        }
                    });
                },
                
                // Göreve tıklandığında detay sayfasına git
                eventClick: function(info) {
                    info.jsEvent.preventDefault(); // Varsayılanı durdur
                    if (info.event.url) {
                        window.location.href = info.event.url;
                    }
                }
            });
            
            calendar.render();
        });
    </script>
    
    <style>
        /* FullCalendar Tailwind/Custom UI Uyarlamaları */
        .fc .fc-toolbar-title { font-weight: 900; color: #1e293b; font-size: 1.5rem; }
        .fc .fc-button-primary { background-color: #4f46e5; border-color: #4f46e5; font-weight: bold; border-radius: 0.5rem; text-transform: capitalize; }
        .fc .fc-button-primary:hover { background-color: #4338ca; border-color: #4338ca; }
        .fc .fc-button-primary:disabled { background-color: #818cf8; border-color: #818cf8; }
        .fc-theme-standard td, .fc-theme-standard th { border-color: #e2e8f0; }
        .fc .fc-daygrid-day.fc-day-today { background-color: #f8fafc; }
        .fc .fc-event { cursor: pointer; border-radius: 4px; padding: 2px 4px; border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.1); transition: transform 0.2s; font-weight: 600; font-size: 0.75rem; }
        .fc .fc-event:hover { transform: translateY(-1px) scale(1.02); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
}
