@model GorevTakipSistemi.Models.Gorev

<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 cursor-grab hover:shadow-md transition-shadow group" data-id="@Model.Id">
    <div class="flex items-center justify-between mb-2">
        @if (Model.Oncelik == "Yüksek")
        {
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-600 border border-red-200">Yüksek</span>
        }
        else if (Model.Oncelik == "Orta")
        {
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-600 border border-amber-200">Orta</span>
        }
        else
        {
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">Düşük</span>
        }
        
        <a href="/Gorev/Details/@Model.Id" target="_blank" class="text-slate-400 hover:text-indigo-600 transition-colors">
            <i class="bi bi-box-arrow-up-right text-xs"></i>
        </a>
    </div>
    
    <h4 class="font-bold text-slate-700 text-sm mb-2 group-hover:text-indigo-600 transition-colors">@Model.GorevAdi</h4>
    
    @if (!string.IsNullOrEmpty(Model.Aciklama))
    {
        <p class="text-xs text-slate-500 line-clamp-2 mb-3">@Model.Aciklama</p>
    }
    
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-slate-50">
        <div class="flex items-center gap-1.5" title="Atanan Kişi">
            <div class="w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-[10px]">
                @if(Model.Kullanici?.Ad != null)
                {
                    @Model.Kullanici.Ad.Substring(0,1).ToUpper()
                }
                else { <i class="bi bi-person"></i> }
            </div>
        </div>
        <div class="text-[10px] font-bold text-slate-400 flex items-center gap-1">
            <i class="bi bi-calendar3"></i> @Model.Tarih.ToString("dd MMM")
        </div>
    </div>
</div>
