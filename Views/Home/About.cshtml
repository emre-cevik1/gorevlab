@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="max-w-4xl mx-auto mt-10 px-4 mb-10">
    <div class="antigravity-card p-8 sm:p-10 text-center">
        <div class="w-20 h-20 bg-gradient-to-tr from-indigo-600 to-cyan-500 rounded-3xl mx-auto flex items-center justify-center shadow-lg shadow-indigo-200 mb-6 transform -rotate-3">
            <i class="bi bi-rocket-takeoff text-4xl text-white"></i>
        </div>
        
        <h1 class="text-3xl font-black text-slate-800 mb-4">GörevLab'a Hoş Geldiniz!</h1>
        <p class="text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
            Takımlar için tasarlanmış modern, hızlı ve güvenli görev yönetim platformu.
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left border-t border-slate-100 pt-8">
            <div class="bg-indigo-50 p-6 rounded-2xl">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white mb-4">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <h3 class="font-bold text-slate-800 mb-2">Hızlı ve Akıcı</h3>
                <p class="text-sm text-slate-600">Modern altyapımız sayesinde sayfalar arası geçişlerde gecikme yaşamazsınız.</p>
            </div>
            
            <div class="bg-amber-50 p-6 rounded-2xl">
                <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center text-white mb-4">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="font-bold text-slate-800 mb-2">Güvenli</h3>
                <p class="text-sm text-slate-600">Verileriniz ve şifreleriniz yüksek güvenlik standartlarında şifrelenir.</p>
            </div>
            
            <div class="bg-emerald-50 p-6 rounded-2xl">
                <div class="w-10 h-10 bg-emerald-500 rounded-xl flex items-center justify-center text-white mb-4">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="font-bold text-slate-800 mb-2">Takım Odaklı</h3>
                <p class="text-sm text-slate-600">Ekipler oluşturun, arkadaşlarınızı davet edin ve görevleri paylaşın.</p>
            </div>
        </div>
    </div>
</div>
